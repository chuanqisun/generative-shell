{
  "name": "serve",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --parallel dev:server dev:web",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "bun --watch web/index.html",
    "check": "bun run format && bun run build && bun run test",
    "format": "prettier --write server/**/* web/**/*",
    "build": "tsc && bun build",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "rxjs": "^7.8.2"
  }
}